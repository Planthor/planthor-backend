# Local Development Environment Variables
# Start infrastructure first: cd infrastructure && docker compose up -d

# .NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# Database & Avatar Storage Connections
ConnectionStrings__PlanthorDbContext=mongodb://localhost:27017/?directConnection=true
# Azure is the local-development default. For Cloud Run with Google Cloud Storage,
# set this to Google and set Storage__Gcs__BucketName to the deployed bucket name.
# Do not set GOOGLE_APPLICATION_CREDENTIALS in Cloud Run; it uses its service identity.
Storage__Provider=Azure
Storage__Gcs__BucketName=REPLACE_WITH_GCS_BUCKET_NAME
Storage__Azure__ConnectionString=REPLACE_WITH_AZURE_STORAGE_CONNECTION_STRING

# MediatR License Key
MediatR__LicenseKey=REPLACE_WITH_MEDIATR_LICENSE_KEY

# Authentication — local Keycloak (infrastructure/compose.yaml → localhost:8180)
Authentication__Keycloak__Authority=http://localhost:8180/realms/planthor
Authentication__Keycloak__Audience=planthor-backend
Authentication__Keycloak__RequireHttpsMetadata=false

# Strava Integration
# Replace the placeholders with values from your Strava application. In Cloud Run,
# inject ClientSecret, WebhookVerifyToken, and StateEncryptionKey from Secret Manager.
Strava__ClientId=REPLACE_WITH_STRAVA_CLIENT_ID
Strava__ClientSecret=REPLACE_WITH_STRAVA_CLIENT_SECRET
Strava__RedirectUri=http://localhost:5008/v1/strava/callback
Strava__FrontendSuccessUrl=planthor://callback?status=success
Strava__FrontendErrorUrl=planthor://callback
Strava__WebhookVerifyToken=REPLACE_WITH_STRAVA_WEBHOOK_VERIFY_TOKEN
# Generate with: openssl rand -base64 32
Strava__StateEncryptionKey=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
Strava__Scopes=activity:read_all,profile:read_all

# Allowed Hosts
AllowedHosts=*
